# Documentation only; the application does not load this file automatically.
# Set an explicit private directory outside the repository locally.
FORESTCHECK_BACKEND_ROOT=
# Generate a random token locally; never store it in source control or URLs.
FORESTCHECK_OPERATOR_TOKEN=
FORESTCHECK_OPERATOR_ID=local-operator
# Empty disables browser cross-origin access. Example allowed local UI origin:
# FORESTCHECK_ALLOWED_ORIGINS=http://127.0.0.1:5173
FORESTCHECK_ALLOWED_ORIGINS=

# Normal server. Synthetic demo uses a separate fresh private root.
FORESTCHECK_DATA_MODE=real
